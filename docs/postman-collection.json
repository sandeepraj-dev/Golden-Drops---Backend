{
  "info": {
    "name": "Oil Mill Management API",
    "_postman_id": "8d174b31-53ac-4d90-a2e2-71d0b1d2c888",
    "description": "Starter collection. Set baseUrl and token variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"YOUR_PASSWORD\"}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "List Customers",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/customers?page=1&limit=20&q=Ravi"
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/dashboard"
      }
    }
  ]
}
